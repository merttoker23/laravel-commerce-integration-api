{
  "name": "merttoker/laravel-commerce-integration-api",
  "description": "Portfolio-ready Laravel commerce backend API demo with supplier, payment and cargo integrations.",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "fakerphp/faker": "^1.23"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "php artisan test",
    "analyse": "vendor/bin/phpstan analyse app --level=5"
  }
}
